@model Complaint

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient mt-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">@(Model.Id != 0 ? "Update" : "Create") Complaint</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form asp-action="Upsert" method="post" class="row" enctype="multipart/form-data">
            <!-- Hidden field for Id -->
            <input asp-for="Id" hidden />

            <div class="row">
                <div class="col-10">
                    <div class="border p-3 mt-4">

                        <!-- Title Input -->
                        <div class="mb-3 row p-1">
                            <label asp-for="Title" class="p-0"></label>
                            <input asp-for="Title" type="text" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <!-- Description Input -->
                        <div class="mb-3 row p-1">
                            <label asp-for="Description" class="p-0"></label>
                            <textarea asp-for="Description" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Location Input -->
                        <div class="mb-3 row p-1">
                            <label asp-for="Location" class="p-0"></label>
                            <input asp-for="Location" type="text" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <!-- File Upload for ImagePath -->
                        <div class="mb-3 row p-1">
                            <label asp-for="ImagePath" class="p-0"></label>
                            <input name="file" type="file" class="form-control" />
                        </div>

                        <!-- Submit and Back Buttons -->
                        <div class="row">
                            <div class="col-6 col-md-3">
                                @if (Model.Id != 0)
                                {
                                    <button type="submit" class="btn btn-primary form-control">Update</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary form-control">Create</button>
                                }
                            </div>
                            <div class="col-6 col-md-3">
                                <a asp-controller="Complaint" asp-action="Index" class="btn btn-outline-primary border form-control">
                                    Back to List
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Image Display -->
                <div class="col-2">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" width="100%" style="border-radius:5px; border:1px solid #bbb9b9;" />
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
